# Set in stage2:
# ---------------------------------------------------------
# set -ef +am
# isFirstRun
# VAR_*
# All functions in /start/functions

if [ "$isFirstRun" == "true" ]
then
   if [ -d "/etc/origo-adm/constants-defaults" ]
   then
      mkdir -p /www/adm/constants
      for sourceFile in /etc/origo-adm/constants-defaults/*
      do
         if [ -f "$sourceFile" ]
         then
            targetFile="/www/adm/constants/$(basename "$sourceFile")"
            if [ ! -e "$targetFile" ]
            then
               cp -a "$sourceFile" "$targetFile"
            fi
         fi
      done
      echo 'copied missing image constants to /www/adm/constants'
   fi
fi