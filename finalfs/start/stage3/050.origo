# Set in stage2:
# ---------------------------------------------------------
# set -ef +am
# isFirstRun
# VAR_*
# All functions in /start/functions

if [ "$isFirstRun" = "true" ]
then
    replaceFileWithLink "/www/index.html" "$VAR_ORIGO_CONFIG_DIR/index.html"
    replaceFileWithLink "/www/index.json" "$VAR_ORIGO_CONFIG_DIR/index.json"
    chmod g+rw "$VAR_ORIGO_CONFIG_DIR/index.html" "$VAR_ORIGO_CONFIG_DIR/index.json"

    if [ -d /www/maps ]; then
        if ! find /www/maps/ -type d -exec chmod g+wx {} +; then
            printf 'Failed to update permissions for directories in /www/maps\n' >&2
        fi

        if ! find /www/maps/ ! -type d ! -type l -exec chmod g+w {} +; then
            printf 'Failed to update group write permissions for entries in /www/maps\n' >&2
        fi
        if [ "$VAR_SYMLINK_MAPS" = "yes" ]
        then
            (
                set +f
    
                for dir in /www/maps/* /www/maps/.[!.]* /www/maps/..?*; do
                    [ -d "$dir" ] || continue
                    link="/www/${dir##*/}"
    
                    if [ -e "$link" ] || [ -L "$link" ]; then
                        printf 'Already exists: %s\n' "$link" >&2
                        continue
                    fi
    
                    if ! ln -s "$dir" /www/; then
                        printf 'Failed to create symlink: %s\n' "$link" >&2
                    fi
                done
    
                for dir in /www/maps/* /www/maps/.[!.]* /www/maps/..?*; do
                    [ -d "$dir" ] || continue
    
                    for file in "$dir"/index.*; do
                        [ -f "$file" ] || continue
                        name=${file##*/}
                        link="/www/${dir##*/}${name#index}"
    
                        if [ -e "$link" ] || [ -L "$link" ]; then
                            printf 'Already exists: %s\n' "$link" >&2
                            continue
                        fi
    
                        if ! ln -s "$file" "$link"; then
                            printf 'Failed to create symlink: %s\n' "$link" >&2
                        fi
                    done
                done
            )
        fi
    fi
fi

cd "$VAR_ORIGO_CONFIG_DIR"
find . -type d -exec mkdir -p "/www/{}" \;
find . -type f -exec ln -sf "$VAR_ORIGO_CONFIG_DIR/{}" "/www/{}" \;
